          <label
            key={label}
            className="flex flex-col items-center gap-2 p-4 rounded-xl border border-[#E2E8F0] cursor-pointer text-sm text-[#1E293B] transition duration-[250ms] has-[:checked]:border-[#006A40] has-[:checked]:bg-[#006A40]/5"
          >
