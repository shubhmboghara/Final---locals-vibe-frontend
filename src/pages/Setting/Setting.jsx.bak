const NAV_ITEMS = [
  { id: "account", label: "Account", icon: FiUser },
  { id: "security", label: "Security", icon: FiShield },
  { id: "privacy", label: "Privacy", icon: FiLock },
  { id: "notifications", label: "Notifications", icon: FiBell },
  { id: "appearance", label: "Appearance", icon: FiMoon },
  { id: "language", label: "Language", icon: FiGlobe },
  { id: "community", label: "Community Preferences", icon: FiHeart },
  { id: "about", label: "About LocalVibe", icon: FiInfo },
];

const EMERGENCY_CONTACTS = [
  { label: "Police", number: "100", icon: MdLocalPolice },
  { label: "Hospital", number: "108", icon: MdLocalHospital },
  { label: "Fire Station", number: "101", icon: MdLocalFireDepartment },
  { label: "Ambulance", number: "102", icon: FaAmbulance },
  { label: "Women's Helpline", number: "1091", icon: MdOutlineHealthAndSafety },
  { label: "Disaster Management", number: "108", icon: MdLocalFireDepartment },
