      </div>
      <div className="flex flex-wrap gap-3 mt-4">
        <button className="px-4 py-2 rounded-full border border-[#E2E8F0] text-[#1E293B] text-xs font-semibold transition duration-[250ms] hover:border-[#006A40] hover:text-[#006A40]">
          Manage Devices
        </button>
        <button className="px-4 py-2 rounded-full border border-[#E2E8F0] text-[#1E293B] text-xs font-semibold transition duration-[250ms] hover:border-[#006A40] hover:text-[#006A40]">
          Recent Login Activity
        </button>
        <button className="px-4 py-2 rounded-full border border-[#EF4444]/30 text-[#EF4444] text-xs font-semibold transition duration-[250ms] hover:bg-[#EF4444] hover:text-white">
          Logout From All Devices
        </button>
