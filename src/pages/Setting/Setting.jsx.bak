const SECTION_MAP = {
  account: AccountSection,
  security: SecuritySection,
  privacy: PrivacySection,
  notifications: NotificationsSection,
  appearance: AppearanceSection,
  language: LanguageSection,
  community: CommunitySection,
  // emergency: EmergencySection,
  // connected: ConnectedSection,
  // data: DataSection,
  // help: HelpSection,
  about: AboutSection,
};

const Settings = () => {
  const [active, setActive] = useState("account");
  // const [darkMode, setDarkMode] = useState(false);
  const ActiveSection = SECTION_MAP[active];
  const dispatch = useDispatch();

  const darkMode = useSelector(
    (state) => state.theme.mode === "dark"
  );

  return (
    <div className="min-h-screen  font-[Poppins,sans-serif] text-[#1E293B]">
      <div className=" max-w-6xl mx-auto h-[calc(100vh-70px)] sm:h-[calc(100vh-80px)] lg:h-[calc(100vh-90px)] px-4 sm:px-6 lg:px-8 py-6 sm:py-10 ">

        <header className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
          <div>
            <h1 className="text-2xl font-bold text-[#0F172A]">Settings</h1>
            <p className="text-sm text-[#64748B] mt-1">Manage your LocalVibe account and preferences.</p>
          </div>
          <div className="flex items-center gap-3">
            <div className="relative hidden sm:block">
              <FiSearch
                size={16}
                className="absolute left-4 top-1/2 -translate-y-1/2 text-[#64748B] pointer-events-none"
              />

              <input
                type="text"
                placeholder="Search settings..."
                className="w-52 rounded-full border border-slate-200 pl-11 pr-4 py-3 text-sm text-neutral-700  placeholder:text-neutral-400 placeholder:font-normal  shadow-sm transition-all duration-200 hover:border-[#006A40] focus:border-[#006A40] focus:ring-4 focus:ring-[#006A40]/15 outline-none"
              />
            </div>
            {/* <button
              onClick={() => setDarkMode(!darkMode)}
              className="w-10 h-10 flex items-center justify-center rounded-full border border-[#E2E8F0] text-[#64748B] transition duration-[250ms] hover:border-[#006A40] hover:text-[#006A40]"
            >
              {darkMode ? <FiSun size={17} /> : <FiMoon size={17} />}
            </button> */}
            <button
              onClick={() => dispatch(toggleTheme())}
              className="w-10 h-10 flex items-center justify-center rounded-full border border-[#E2E8F0] dark:border-neutral-700 bg-white dark:bg-neutral-800 text-[#64748B] dark:text-slate-300 transition-all duration-300 hover:border-[#006A40] hover:text-[#006A40] hover:scale-105"
              aria-label="Toggle Theme"
            >
              {darkMode ? <FiSun size={17} /> : <FiMoon size={17} />}
            </button>
            <Link
              to="/Profile"
              className="w-10 cursor-pointer h-10 rounded-full bg-gradient-to-br from-[#006A40] to-[#0F172A] flex items-center justify-center text-white text-sm font-bold">
              MP
            </Link>
          </div>
        </header>

        <div className="flex flex-col lg:flex-row gap-6">
          {/* Sidebar — collapsible scroll row on mobile/tablet, fixed column on desktop */}
          <aside className="lg:w-64 shrink-0">
            <nav className="flex lg:flex-col gap-1.5 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 -mx-1 px-1 lg:mx-0 lg:px-0">
              {NAV_ITEMS.map(({ id, label, icon: Icon }) => (
                <button
                  key={id}
                  onClick={() => setActive(id)}
                  className={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium whitespace-nowrap transition-all duration-[250ms] shrink-0
                    ${active === id
                      ? "bg-[#006A40] text-white "
                      : "text-[#64748B] hover:bg-white hover:text-[#0F172A]"
                    }`}
                >
                  <Icon size={17} />
                  {label}
                </button>
              ))}
            </nav>
          </aside>

          {/* Content */}
          <main className="flex-1 min-w-0">
            <ActiveSection />
          </main>
        </div>

        <footer className="border-t border-[#E2E8F0] mt-7 pt-6 pb-4">
          <div className="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-[#64748B]">
            {["About LocalVibe", "Privacy Policy", "Terms of Service", "Contact Us"].map((link) => (
              <a key={link} href="#" className="transition duration-[250ms] hover:text-[#006A40]">
                {link}
              </a>
            ))}
          </div>
        </footer>

      </div>
    </div>
  );
};

export default Settings;