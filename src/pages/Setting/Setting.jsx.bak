const COMMUNITY_CATEGORIES = [
  "Events", "Sports", "Education", "Technology", "Food", "Travel",
  "Volunteer", "Marketplace", "Lost & Found", "Emergency", "Announcements", "News",
];

const Card = ({ title, subtitle, children, className = "" }) => (
  <div className={`bg-white rounded-2xl border border-[#E2E8F0] shadow-[0_8px_24px_rgba(15,23,42,0.04)] p-6 ${className}`}>
    {title && (
      <div className="mb-4">
        <h3 className="text-[#0F172A] text-base font-semibold">{title}</h3>
        {subtitle && <p className="text-[#64748B] text-xs mt-1">{subtitle}</p>}
      </div>
    )}
    {children}
  </div>
);

const Toggle = ({ label, description, defaultChecked = true }) => {
  const [on, setOn] = useState(defaultChecked);
  return (
    <div className="flex items-center justify-between py-3">
      <div>
        <p className="text-sm font-medium text-[#1E293B]">{label}</p>
        {description && <p className="text-xs text-[#64748B] mt-0.5">{description}</p>}
      </div>
      <button
        onClick={() => setOn(!on)}
        className={`relative w-11 h-6 rounded-full shrink-0 transition-colors duration-[250ms] ${on ? "bg-[#006A40]" : "bg-[#E2E8F0]"
          }`}
      >
        <span
          className={`absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-[250ms] ${on ? "translate-x-5" : "translate-x-0"
            }`}
        />
      </button>
    </div>
  );
};

const Field = ({ label, type = "text", defaultValue = "", placeholder = "" }) => (
  <div className="flex flex-col gap-1.5">
    <label className="text-xs font-medium text-[#64748B]">{label}</label>
    <input
      type={type}
      defaultValue={defaultValue}
      placeholder={placeholder}
      className="w-full px-4 py-2.5 border border-[#E2E8F0] rounded-xl text-sm text-[#1E293B] outline-none transition duration-[250ms] focus:border-[#006A40] focus:shadow-[0_0_0_4px_rgba(0,106,64,0.1)]"
    />
  </div>
);

const AccountSection = () => (
  <Card title="Account Settings" subtitle="Update your photo and personal details.">
    <div className="flex items-center gap-4 mb-6">
      <div className="w-16 h-16 rounded-full bg-gradient-to-br from-[#006A40] to-[#0F172A] flex items-center justify-center text-white text-xl font-bold">
        MP
      </div>
      <div className="flex gap-2">
        <button className="px-4 py-2 rounded-full bg-[#006A40] text-white text-xs font-semibold transition duration-[250ms] hover:bg-[#00532f]">
          Upload Photo
        </button>
        <button className="px-4 py-2 rounded-full border border-[#E2E8F0] text-[#64748B] text-xs font-semibold transition duration-[250ms] hover:border-[#EF4444] hover:text-[#EF4444]">
          Remove
        </button>
      </div>
    </div>
    <div className="grid sm:grid-cols-2 gap-4">
      <Field label="Full Name" defaultValue="Manan Patel" />
      <Field label="Username" defaultValue="manan_dev" />
      <Field label="Email" type="email" defaultValue="manan@example.com" />
      <Field label="Phone Number" defaultValue="+91 98765 43210" />
      <Field label="Location" defaultValue="Ahmedabad, Gujarat" />
    </div>
    <div className="mt-4">
      <label className="text-xs font-medium text-[#64748B]">Bio</label>
      <textarea
        rows={3}
        defaultValue="Frontend developer building tools that bring neighbors closer together."
        className="w-full mt-1.5 px-4 py-2.5 border border-[#E2E8F0] rounded-xl text-sm text-[#1E293B] outline-none resize-none transition duration-[250ms] focus:border-[#006A40] focus:shadow-[0_0_0_4px_rgba(0,106,64,0.1)]"
      />
    </div>
    <div className="flex gap-3 mt-6">
      <button className="px-6 py-2.5 rounded-full bg-[#006A40] text-white text-sm font-semibold transition duration-[250ms] hover:bg-[#00532f] hover:-translate-y-0.5">
        Save Changes
      </button>
      <button className="px-6 py-2.5 rounded-full border border-[#E2E8F0] text-[#64748B] text-sm font-semibold transition duration-[250ms] hover:bg-[#F8FAFC]">
        Cancel
      </button>
    </div>
  </Card>
);

const SecuritySection = () => (
  <div className="flex flex-col gap-4">
    <Card title="Password">
      <div className="flex gap-5">
        <Link to="/Reset-Password" className="cursor-pointer">
          <button className="flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#006A40] text-white text-sm font-semibold transition duration-[250ms] hover:bg-[#00532f]">
            <FiLock size={15} /> Change Password
          </button>
        </Link>
        <Link to="/Forget-Password" className="cursor-pointer">
          <button className="flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#006A40] text-white text-sm font-semibold transition duration-[250ms] hover:bg-[#00532f]">
